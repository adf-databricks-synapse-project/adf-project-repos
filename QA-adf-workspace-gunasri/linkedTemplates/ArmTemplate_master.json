{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "QA-adf-workspace-gunasri"
		},
		"LS_AzureDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLakeStorage'"
		},
		"LS_AzureDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://bankingdatalakegunasri.dfs.core.windows.net/"
		},
		"Ls_Onprem_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Banking Analytics project"
		},
		"Ls_Onprem_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-GISCLTN\\gunas"
		},
		"Ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://adf-keyvault-gunasri.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "QA-adf-workspace-gunasri_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureDataLakeStorage_accountKey": {
						"value": "[parameters('LS_AzureDataLakeStorage_accountKey')]"
					},
					"LS_AzureDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLakeStorage_properties_typeProperties_url')]"
					},
					"Ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('Ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"Ls_Onprem_properties_typeProperties_host": {
						"value": "[parameters('Ls_Onprem_properties_typeProperties_host')]"
					},
					"Ls_Onprem_properties_typeProperties_userId": {
						"value": "[parameters('Ls_Onprem_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}